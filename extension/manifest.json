{
  "manifest_version": 3,
  "name": "ApplyVault",
  "short_name": "ApplyVault",
  "description": "Track job applications and visa sponsorship worldwide. Reads job info from the active tab when you click. All data stays local.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workday.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.glassdoor.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.icims.com/*",
    "*://*.taleo.net/*",
    "*://*.ashbyhq.com/*",
    "*://*.wellfound.com/*",
    "*://*.angel.co/*",
    "*://*.jobvite.com/*",
    "*://*.bamboohr.com/*",
    "*://*.workable.com/*",
    "*://*.recruitee.com/*",
    "*://*.builtin.com/*",
    "*://*.dice.com/*",
    "*://*.ziprecruiter.com/*",
    "*://*.monster.com/*",
    "*://*.simplyhired.com/*",
    "*://*.careerbuilder.com/*",
    "*://*.joinhandshake.com/*",
    "*://*.otta.com/*",
    "*://*.mynexthire.io/*",
    "*://*.rippling.com/*",
    "*://*.gem.com/*",
    "*://*.pinpointhq.com/*",
    "*://*.breezy.hr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyVault — Job Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  }
}
